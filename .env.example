# ============================================================
# Plex Dedup — configuration template
# Copy to .env and fill in your values:  cp .env.example .env
# Only PLEX_TOKEN is strictly required; everything else has a sane default.
# ============================================================

# ---- Plex (required) ----
PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=
PLEX_MOVIE_LIBRARY=Movies
PLEX_TV_LIBRARY=TV Shows

# ---- Radarr (required for movie dedup / convert) ----
RADARR_URL=http://192.168.1.100:7878
RADARR_API_KEY=

# ---- Sonarr (required for TV dedup / convert) ----
SONARR_URL=http://192.168.1.100:8989
SONARR_API_KEY=

# ---- Prowlarr (required for the Swedish convert pipeline) ----
PROWLARR_URL=http://192.168.1.100:9696
PROWLARR_API_KEY=

# ---- OpenSubtitles (required for subtitle download) ----
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
SUBTITLE_LANGUAGES=sv,en
SUBTITLE_MATCH_TAGS=NORDIC,SWE,SWESUB,SWEDISH
SUBTITLE_AUTO_DOWNLOAD=true
SUBTITLE_DAILY_LIMIT=20
SUBTITLE_QUEUE_HOUR=4

# ---- Behavior ----
# DRY_RUN=true previews everything and changes nothing. Set to false to let the
# app actually delete files and grab releases. Only "true"/"false" are honored.
DRY_RUN=true
KEEP_STRATEGY=best_quality
AUTO_UNMONITOR=true
DELETE_FILES=true
# Move deleted files here instead of removing them (leave blank to delete):
RECYCLE_BIN=

# ---- Convert / retry tuning ----
CONVERT_MAX_SIZE_GB=25
SKIP_EXPIRY_DAYS=30
SEARCH_COOLDOWN_DAYS=30
GRAB_REFRESH_BEFORE=0

# ---- Web ----
WEB_PORT=8585
# Keep WEB_HOST=0.0.0.0 under Docker — a loopback bind can't receive the
# published port.
WEB_HOST=0.0.0.0

# ---- System ----
TZ=Europe/Stockholm
